{
  "name": "pi-stuff",
  "version": "0.1.0",
  "description": "Personal pi extensions, skills, prompts and themes",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "test:real": "node --test 'test/real/*.test.ts'",
    "test:all": "npm test && npm run test:real",
    "test:watch": "node --test --watch 'test/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/patch-pi-test-harness.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@marcfargas/pi-test-harness": "^0.6.1",
    "@types/node": "^26.6.6",
    "pi-coding-agent-test": "^0.1.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@isdk/template-engines": "^0.6.12"
  }
}
